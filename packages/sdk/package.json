{
  "name": "@imanshu03/jev-browser-use",
  "version": "0.1.0",
  "description": "The public library API of jev-browser-use, for test runners and other tools",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imanshu03/jev-browser-use.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
