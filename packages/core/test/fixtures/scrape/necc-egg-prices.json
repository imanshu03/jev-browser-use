{
  "kind": "jev-scraper",
  "format": 1,
  "name": "necc-egg-prices",
  "version": 1,
  "created_at": "2026-09-27T12:00:00+05:30",
  "updated_at": "2026-09-27T12:00:00+05:30",
  "task": "Open the NECC daily egg price sheet for month {month} of {year}",
  "want": "One row per zone and day: zone, day, rate per 100 eggs, and the section (suggested or prevailing).",
  "params": {
    "month": "08",
    "year": "2026"
  },
  "profile": "Parallelloop",
  "start_url": "https://www.e2necc.com/home/eggprice",
  "steps": [
    {
      "op": "select",
      "target": {
        "role": "combobox",
        "name": "01 02 03 04 05 06 07 08 09 10 11 12",
        "match": "starts"
      },
      "value": "{month}"
    },
    {
      "op": "select",
      "target": {
        "role": "combobox",
        "name": "2026 2025",
        "match": "starts"
      },
      "value": "{year}"
    },
    {
      "op": "click",
      "target": {
        "role": "button",
        "name": "Get Sheet"
      }
    }
  ],
  "load": {
    "mode": "none"
  },
  "extract": {
    "source": "table",
    "match": {
      "headers": [
        "name of zone / day",
        "1",
        "2",
        "3",
        "average"
      ],
      "width": 32
    },
    "fields": {
      "zone": {
        "from": "column",
        "header": "name of zone / day",
        "parser": "text",
        "index_hint": 0
      },
      "section": {
        "from": "section",
        "parser": "text"
      },
      "month": {
        "from": "meta",
        "key": "ddlMonth"
      },
      "year": {
        "from": "meta",
        "key": "ddlYear"
      }
    },
    "melt": {
      "name_field": "day",
      "value_field": "rate",
      "value_parser": "number",
      "skip": [
        "average"
      ],
      "drop_empty": true
    },
    "key": [
      "section",
      "zone",
      "day"
    ]
  },
  "validate": {
    "min_rows": 500,
    "required": [
      "zone",
      "day",
      "rate"
    ],
    "expect_keys": {
      "field": "zone",
      "values": [
        "Hyderabad",
        "Namakkal"
      ]
    }
  },
  "fingerprint": {
    "source": "table",
    "headers": [
      "name of zone / day",
      "1",
      "2",
      "3",
      "average"
    ],
    "slot_keys": [],
    "fields": {
      "zone": {
        "type": "string",
        "column": "name of zone / day"
      },
      "day": {
        "type": "string"
      },
      "rate": {
        "type": "number"
      },
      "section": {
        "type": "string"
      },
      "month": {
        "type": "string"
      },
      "year": {
        "type": "string"
      }
    },
    "keys": [
      "Ahmedabad",
      "Hyderabad",
      "Namakkal"
    ],
    "row_count": 946,
    "url_path": "/home/eggprice"
  },
