{
  "name": "@imanshu03/jev-core",
  "version": "0.1.0",
  "description": "The jev engine: Chrome over CDP, the Jev step loop, record and replay, and the page reader",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imanshu03/jev-browser-use.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./*.js": {
      "jev-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./test/*.js": {
      "jev-source": "./test/*.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "JEV_LIVE=1 vitest run test/fast/page.live.test.ts test/fast/pointer-rows.live.test.ts test/fast/read.live.test.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "agent-browser": "^0.38.1",
    "undici": "^7.29.1",
    "zod": "^4.6.5"
  }
}
