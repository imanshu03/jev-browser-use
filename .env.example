# Copy this file to .env and set your TypeSafe API key.
# Keep .env private. Git ignores it.

# Required for one-shot tasks and smoke runs.
# Chat can use a saved key or ask for one when this value is empty.
# A non-empty value overrides the key saved by chat.
TYPESAFE_API_KEY=

# Optional settings. Uncomment only the settings you want to change.

# Engine: cdp (default), chromium, or vercel. --engine overrides this setting.
# JEV_BROWSER_ENGINE=cdp

# Model used for task decisions. Default: jev-latest.
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Maximum steps per task. Default: 25. --max-steps overrides this setting.
# JEV_BROWSER_MAX_STEPS=25

# Default profile name or directory for the selected browser.
# Use none for a temporary profile. --profile overrides this setting.
# When unset, resolve a task profile or the available Parallelloop profile.
# AGENT_BROWSER_PROFILE=none

# One-shot session name. By default, each run gets a unique name.
# Chat creates its own name; use --session to set a chat session name.
# AGENT_BROWSER_SESSION=jev-local

# Browser binary overrides. Use an absolute path for your system.
# --chrome-bin overrides these settings. Attachment with --cdp skips launch.
# Used by the cdp engine:
# JEV_CHROME_BIN="/absolute/path/to/chrome"
# Used by the chromium engine:
# JEV_CHROMIUM_BIN="/absolute/path/to/chromium"

# Vercel engine CLI override. Default: package-local node_modules/.bin/agent-browser.
# JEV_BROWSER_BIN="/absolute/path/to/agent-browser"

# Saved chat key file. Default: <config-root>/jev-browser/config.json.
# JEV_BROWSER_CONFIG="/absolute/path/to/jev-browser/config.json"

# Configuration root for saved keys and copied browser profiles.
# Default: ~/.config. Use an absolute path; .env does not expand ~ or $HOME.
# XDG_CONFIG_HOME="/absolute/path/to/config"

# Early decisions: the next Jev request goes out while the page settles after an input.
# Default: on. Set 0 to wait for the settle first.
# JEV_EARLY_DECISIONS=0

# Text model for new field text in the CLI and chat (messages, replies, descriptions).
# Off unless both JEV_TEXT_MODEL and JEV_TEXT_API_KEY are set. Any OpenAI-compatible endpoint.
# The request sends the redacted task, the page URL and title, the labels and current values of the fields
# (up to 2,000 characters of text already in the field), the recent actions with their typed text, the texts sent
# in this run, and up to 6,000 characters of page text to the endpoint.
# JEV_TEXT_MODEL=inception/mercury-2.5
# JEV_TEXT_API_KEY=
# JEV_TEXT_BASE_URL=https://openrouter.ai/api/v1
# JEV_TEXT_REASONING=none

# Engine for npm run smoke. Default: cdp. Also accepts chromium or vercel.
# Smoke runs need real API access and prepared browser profiles.
# SMOKE_ENGINE=cdp
